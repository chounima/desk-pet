{
  "_說明": "客人角色（多人／直播模式）：聊天關鍵字與表情反應會讓對應的客人做動作。match 裡的英數字要整個字相符，中日文只要有出現就算。",
  "maxGuests": 8,
  "chatIdleMinutes": 10,
  "chatMaxChars": 40,
  "scale": 0.85,
  "_meetingApps": "偵測音量的會議軟體 { 程式名稱（工作管理員裡的名稱，不含 .exe）: 顯示名稱 }。瀏覽器（Google Meet）也會播影片聲音，預設不列。",
  "meetingApps": {
    "zoom": "Zoom",
    "ms-teams": "Teams",
    "teams": "Teams",
    "line": "LINE",
    "webex": "Webex",
    "ciscocollabhost": "Webex",
    "skype": "Skype",
    "slack": "Slack",
    "telegram": "Telegram",
    "whatsapp": "WhatsApp",
    "messenger": "Messenger",
    "googlemeet": "Google Meet"
  },
  "micThreshold": 0.06,
  "appThreshold": 0.02,
  "_rules": "觸發規則（格式見 schemas/rules.schema.json）：依順序找第一個符合的。when.source = chat（match：英數字要整個字相符，中日文出現就算）或 reaction（emoji，\"*\" = 其他）；do 可以有 action、face、line、fx；cooldown = 同一個人多久內不重複（秒）；priority 預設 10。",
  "rules": [
    { "when": { "source": "chat", "match": ["!jump", "!跳"] }, "do": { "action": "jump" } },
    { "when": { "source": "chat", "match": ["!dance", "跳舞", "dance"] }, "do": { "action": "dance" } },
    { "when": { "source": "chat", "match": ["!wave", "hi", "hello", "hey", "嗨", "哈囉", "安安", "你好", "こんにちは", "やあ"] }, "do": { "action": "wave" } },
    { "when": { "source": "chat", "match": ["bye", "掰", "拜拜", "再見", "またね"] }, "do": { "action": "wave" } },
    { "when": { "source": "chat", "match": ["哈哈", "lol", "lmao", "xd", "笑死", "www", "草"] }, "do": { "action": "cheer" } },
    { "when": { "source": "chat", "match": ["gg", "nice", "讚", "好耶", "+1", "いいね"] }, "do": { "action": "peace" } },
    { "when": { "source": "chat", "match": ["嗯…", "嗯...", "hmm", "想想", "うーん"] }, "do": { "action": "think" } },
    { "when": { "source": "chat", "match": ["晚安", "gn", "おやすみ", "睏", "zzz"] }, "do": { "action": "sleep" } },
    { "when": { "source": "chat", "match": ["累", "tired", "伸懶腰", "疲れた"] }, "do": { "action": "stretch" } },
    { "when": { "source": "chat", "match": ["咖啡", "coffee", "コーヒー"] }, "do": { "action": "coffee" } },
    { "when": { "source": "chat", "match": ["生氣", "怒", "angry", "💢"] }, "do": { "action": "angry" } },
    { "when": { "source": "chat", "match": ["害羞", "///", "shy", "照れ"] }, "do": { "action": "shy" } },
    { "when": { "source": "chat", "match": ["!salute", "收到", "遵命", "roger", "了解"] }, "do": { "action": "salute" } },
    { "when": { "source": "reaction", "emoji": ["👍", "✌"] }, "do": { "action": "peace" } },
    { "when": { "source": "reaction", "emoji": ["🎉", "❤", "😂", "🤣"] }, "do": { "action": "cheer" } },
    { "when": { "source": "reaction", "emoji": ["👋"] }, "do": { "action": "wave" } },
    { "when": { "source": "reaction", "emoji": ["😡", "😠"] }, "do": { "action": "angry" } },
    { "when": { "source": "reaction", "emoji": ["😳", "🥺"] }, "do": { "action": "shy" } },
    { "when": { "source": "reaction", "emoji": ["🤔"] }, "do": { "action": "think" } },
    { "when": { "source": "reaction", "emoji": ["😴"] }, "do": { "action": "sleep" } },
    { "when": { "source": "reaction", "emoji": ["☕"] }, "do": { "action": "coffee" } },
    { "when": { "source": "reaction", "emoji": ["🫡"] }, "do": { "action": "salute" } },
    { "when": { "source": "reaction", "emoji": ["*"] }, "do": { "action": "jump" } }
  ]
}
