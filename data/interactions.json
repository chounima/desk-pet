      { "min": 1, "action": "cheer", "line": "highFive", "time": 1.8 }
    ],
    "feet": [
      { "min": 1, "action": "jump", "line": "startle" }
    ],
    "tail": [
      { "min": 1, "action": "angry", "line": "tail", "time": 2 }
