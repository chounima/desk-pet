      "period": 3.4,
      "tracks": {
        "torso.sy": { "amp": 0.018 },
        "torso": { "amp": 0.8, "phase": 0.3 },
        "head": { "amp": -0.6, "phase": 0.5 },
        "armNear_u": { "amp": 1.2, "phase": 0.2 },
        "armFar_u": { "amp": 1.2, "phase": 0.2 }
      }
    },
    "sway": {
