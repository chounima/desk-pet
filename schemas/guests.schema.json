{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guests.schema.json",
  "title": "客人角色 data/guests.json",
  "type": "object",
  "properties": {
    "maxGuests": {
      "type": "integer",
      "minimum": 1
    },
    "chatIdleMinutes": {
      "type": "number"
    },
    "chatMaxChars": {
      "type": "integer",
      "minimum": 1
    },
    "scale": {
      "type": "number"
    },
    "meetingApps": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "micThreshold": {
      "type": "number"
    },
    "appThreshold": {
      "type": "number"
    },
    "rules": {
      "$ref": "rules.schema.json"
    }
  }
}
