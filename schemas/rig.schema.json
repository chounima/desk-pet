{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rig.schema.json",
  "title": "角色骨架 art/characters/<id>/rig.json（型態：forms/<名稱>/rig.json）",
  "type": "object",
  "required": [
    "id",
    "bones",
    "slots"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "格式版本；沒有 = 1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "body": {
      "enum": [
        "humanoid",
        "quadruped"
      ],
      "description": "體型，決定用哪一套動作"
    },
    "rootScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "headTop": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "height": {
      "type": "number"
    },
    "trackScale": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "動作軌道幅度倍率 { 軌道: 倍率 }"
    },
    "propOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dx": {
            "type": "number"
          },
          "dy": {
            "type": "number"
          },
          "scale": {
            "type": "number"
          }
        }
      },
      "description": "道具位置／大小修正 { 道具: { dx, dy, scale } }"
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/anchor"
      },
      "description": "錨點：配件（hat、eyes、neck、back）、嘴巴（mouth，聲波）、名牌（nameTag）…"
    },
    "bones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bone"
      },
      "minItems": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "rig": {
            "type": "string"
          }
        },
        "required": [
          "rig"
        ]
      },
      "description": "可切換的型態 { 名稱: { label, rig（資料夾，空字串 = 本身） } }"
    },
    "volley": {
      "type": "object",
      "properties": {
        "reach": {
          "type": "number"
        },
        "hitHeight": {
          "type": "number"
        },
        "spike": {
          "type": "boolean"
        },
        "dive": {
          "type": "boolean"
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/physics"
      },
      "description": "（第 1 階段）次級物理 { 骨骼: 參數 }"
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "（第 6 階段）其他視角，例如 bust（正面半身）"
    },
    "bust": {
      "type": "object",
      "properties": {
        "top": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "description": "（第 6 階段）半身取景"
    },
    "face": {
      "type": "object",
      "description": "分層臉（選配）：圖層照順序疊，表情決定每層用哪張圖；由 Game/Face/FaceDriver.cs、game/faceDriver.js 驅動。沒有就只用表情插槽的整張臉",
      "required": [
        "box",
        "layers",
        "expressions"
      ],
      "properties": {
        "box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "所有圖層共用的範圍（頭部座標）"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "variants"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "eyes、pupils、lids、brows、blush、mouth、extras…"
              },
              "variants": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "{ 圖名: 檔案 }"
              },
              "follow": {
                "type": "string",
                "description": "跟著哪一層換圖（用同名的圖，沒有就不顯示），例如瞳孔跟著 eyes"
              },
              "move": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "視線位移範圍 [左, 上, 右, 下]"
              }
            }
          }
        },
        "expressions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": "{ 表情: { 圖層: 圖名 } }，沒列的圖層不顯示"
        },
        "alpha": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "description": "{ 表情: { 圖層: 不透明度 } }"
        },
        "talk": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "講話時嘴巴管道的值（half、open、a、i、u、e、o）→ 嘴型圖名"
        }
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "properties": {
        "bone": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        },
        "depth": {
          "type": "number",
          "description": "轉頭視差的深度：看游標時位移 = 臉的位移 × depth（臉 = 1、前髮 > 1、後髮 < 0；沒有 = 不動）"
        }
      },
      "required": [
        "bone"
      ]
    },
    "bone": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "name"
      ]
    },
    "slot": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "bone": {
          "type": "string"
        },
        "z": {
          "type": "number"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x0, y0, x1, y1]，Q 版單位"
        },
        "far": {
          "type": "boolean"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "表情插槽 { 表情名: 檔案 }"
        },
        "alt": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "box": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "[x0, y0, x1, y1]，Q 版單位"
              }
            },
            "required": [
              "file"
            ]
          },
          "description": "部件替換圖"
        },
        "mesh": {
          "type": "object",
          "description": "（第 4 階段）網格變形"
        },
        "depth": {
          "type": "number",
          "description": "轉頭視差的深度：看游標時位移 = 臉的位移 × depth（臉 = 1、前髮 > 1、後髮 < 0；沒有 = 不動）"
        }
      },
      "required": [
        "name",
        "bone"
      ]
    },
    "physics": {
      "type": "object",
      "properties": {
        "stiffness": {
          "type": "number"
        },
        "damping": {
          "type": "number"
        },
        "gravity": {
          "type": "number"
        },
        "inertia": {
          "type": "number"
        },
        "limit": {
          "type": "number"
        },
        "drag": {
          "type": "number"
        },
        "length": {
          "type": "number"
        },
        "axis": {
          "type": "number"
        }
      }
    }
  }
}
